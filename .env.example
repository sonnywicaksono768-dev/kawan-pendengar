# Salin ke .env.local lalu isi nilainya.
# Jangan pernah commit .env atau .env.local.

# Layer 3: 9Router (alamat tanpa /v1/...)
NINEROUTER_URL=
NINEROUTER_API_KEY=

# Model yang dipakai
LLM_MODEL=
LLM_CLASSIFIER_MODEL=
LLM_TIMEOUT_MS=20000

# Jalur cadangan langsung ke provider, urut sesuai prioritas.
# Nilai yang dikenal: gemini, groq, openrouter
FALLBACK_PROVIDERS=gemini,groq,openrouter

# Kunci provider cadangan
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Batas per IP
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=200

# Rate limit Redis (opsional). Tanpa ini dipakai Map in-memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Salt untuk hash IP. Wajib diganti dengan string acak panjang.
IP_HASH_SALT=ganti-dengan-string-acak-panjang

# Default non-streaming sesuai blueprint 9.7
STREAMING_ENABLED=false

# Hanya untuk pengembangan lokal. Jangan diisi di production.
LLM_DEMO=0
